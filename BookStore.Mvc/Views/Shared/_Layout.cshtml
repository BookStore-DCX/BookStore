<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookNest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">B</span>
                    <span>BookNest</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-4">
                        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Books</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Authors" asp-action="Index">Authors</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Publishers" asp-action="Index">Publishers</a></li>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            @if (User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Index">Inventory</a></li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                            }
                            @if (User.IsInRole("RegisteredUser") || User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Cart <span class="badge cart-badge" id="cartCountBadge"></span></a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="navbar-text small">Hi, @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="btn btn-outline-dark btn-sm" type="submit">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Register">Create Account</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer">
        <div class="container py-4 d-flex flex-wrap justify-content-between gap-2">
            <span>BookNest Bookstore</span>
            <span class="text-muted">Browse, review, and buy from your BookStore API.</span>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.bookStoreUserIsSignedIn = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <div class="login-popup-overlay" id="loginPopup" aria-hidden="true">
        <div class="login-popup">
            <h4>Login required</h4>
            <p>Please login first to view book details.</p>
            <button type="button" class="btn btn-brand btn-sm" id="loginPopupClose">OK</button>
        </div>
    </div>
</body>
</html>