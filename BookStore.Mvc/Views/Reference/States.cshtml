@model List<StateViewModel>
@{
    ViewData["Title"] = "States";
}

<div class="page-title"><h1 class="h3 mb-0">States</h1></div>
<div class="content-panel p-3">
    <table class="table"><thead><tr><th>Code</th><th>Name</th></tr></thead><tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.StateCode</td><td>@item.StateName</td></tr>
    }
    </tbody></table>
</div>
