@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="page-title"><h1 class="h3 mb-0">Categories</h1></div>
<div class="content-panel p-3">
    <table class="table"><thead><tr><th>ID</th><th>Description</th></tr></thead><tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.CatId</td><td>@item.CatDescription</td></tr>
    }
    </tbody></table>
</div>
