@model List<BookListItemViewModel>
@{
    ViewData["Title"] = "Books";
}

<section class="catalog-hero mb-4 bg-success bg-opacity-10">
    <div>
        <h3>Search All Books</h3>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
    {
        <a class="btn btn-success" asp-action="Create">Add Book</a>
    }
</section>

<form method="get" class="search-panel mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-3"><input class="form-control form-control-lg" name="title" value="@ViewBag.TitleFilter" placeholder="Search by title" /></div>
        <div class="col-md-3"><input class="form-control form-control-lg" name="authorName" value="@ViewBag.AuthorFilter" placeholder="Author name" /></div>
        <div class="col-md-3"><input class="form-control form-control-lg" name="description" value="@ViewBag.DescriptionFilter" placeholder="Keyword" /></div>
        <div class="col-md-2">
            <select class="form-select form-select-lg" name="categoryId" asp-items="ViewBag.Categories">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-1 d-grid"><button class="btn btn-dark btn-lg" type="submit">Find</button></div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Available Books</h2>
    <span class="text-muted">@Model.Count titles</span>
</div>

<div class="d-flex justify-content-center align-items-center gap-2 mb-3" data-card-pager="#booksGrid">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-page-prev>Prev 10</button>
    <label class="small text-muted mb-0" for="booksPageSize">Rows</label>
    <input id="booksPageSize"
           type="number"
           min="1"
           value="10"
           class="form-control form-control-sm"
           style="width: 90px;"
           data-page-size />
    <button type="button" class="btn btn-outline-secondary btn-sm" data-page-next>Next 10</button>
</div>

<div class="row g-4" id="booksGrid">
    @foreach (var book in Model)
    {
        var rawDescription = string.IsNullOrWhiteSpace(book.Description)
            ? "A bookstore selection ready to explore."
            : book.Description;

        var displayDescription = rawDescription.Length > 30
            ? rawDescription[..30] + "..."
            : rawDescription;

        <div class="col-md-6 col-xl-4" data-page-item>
            <article class="book-card">
                <div class="book-cover" aria-hidden="true">
                    <span>@(string.IsNullOrWhiteSpace(book.Title) ? "B" : book.Title.Substring(0, 1))</span>
                </div>
                <div class="book-card-body">
                    <p class="book-meta">@book.CategoryName</p>
                    <h3>@book.Title</h3>

                    <p class="book-description" title="@rawDescription">@displayDescription</p>

                    <div class="book-card-footer">
                        <span class="stock-pill">@book.InventoryCount copies</span>
                        <a class="btn btn-sm btn-brand" asp-action="Details" asp-route-id="@book.Isbn">View Book</a>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
                    {
                        <div class="mt-3 pt-3 border-top">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@book.Isbn">Edit</a>
                            <form class="d-inline" asp-action="Delete" asp-route-id="@book.Isbn" method="post" data-confirm="Delete this book?">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </div>
                    }
                </div>
            </article>
        </div>
    }
</div>