@model List<BookListItemViewModel>
@{
    ViewData["Title"] = "Books";
}

<section class="catalog-hero mb-4">
    <div>
        <p class="section-kicker">Curated shelves</p>
        <h1>Find your next good read</h1>
        <p>Search the catalog, explore editions, and check available copies from the live bookstore inventory.</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
    {
        <a class="btn btn-light" asp-action="Create">Add Book</a>
    }
</section>

<form method="get" class="search-panel mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-4"><input class="form-control form-control-lg" name="title" value="@ViewBag.TitleFilter" placeholder="Search by title" /></div>
        <div class="col-md-4"><input class="form-control form-control-lg" name="authorName" value="@ViewBag.AuthorFilter" placeholder="Author name" /></div>
        <div class="col-md-3"><input class="form-control form-control-lg" name="description" value="@ViewBag.DescriptionFilter" placeholder="Keyword" /></div>
        <div class="col-md-1 d-grid"><button class="btn btn-dark btn-lg" type="submit">Find</button></div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Available Books</h2>
    <span class="text-muted">@Model.Count titles</span>
</div>

<div class="row g-4">
    @foreach (var book in Model)
    {
        <div class="col-md-6 col-xl-4">
            <article class="book-card">
                <div class="book-cover" aria-hidden="true">
                    <span>@(string.IsNullOrWhiteSpace(book.Title) ? "B" : book.Title.Substring(0, 1))</span>
                </div>
                <div class="book-card-body">
                    <p class="book-meta">@book.CategoryName</p>
                    <h3>@book.Title</h3>
                    <p class="book-isbn">@book.Isbn</p>
                    <p class="book-description">@(string.IsNullOrWhiteSpace(book.Description) ? "A bookstore selection ready to explore." : book.Description)</p>
                    <div class="book-card-footer">
                        <span class="stock-pill">@book.InventoryCount copies</span>
                        <a class="btn btn-sm btn-brand" asp-action="Details" asp-route-id="@book.Isbn">View Book</a>
                    </div>
                    @if (User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
                    {
                        <div class="mt-3 pt-3 border-top">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@book.Isbn">Edit</a>
                            <form class="d-inline" asp-action="Delete" asp-route-id="@book.Isbn" method="post" data-confirm="Delete this book?">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </div>
                    }
                </div>
            </article>
        </div>
    }
</div>
