@model List<InventoryViewModel>
@{
    ViewData["Title"] = "Inventory";
}

<div class="page-title">
    <h1 class="h3 mb-0">Inventory</h1>
</div>

<div class="content-panel p-3">
    <div class="d-flex align-items-center gap-2 mb-3">
        <input class="form-control"
               placeholder="Filter inventory"
               data-table-filter="#inventoryTable"
               style="flex: 1 1 auto;" />
        <a class="btn btn-primary ms-auto author-toolbar-button" asp-action="Create">Add Copy</a>
    </div>

    <div class="d-flex justify-content-center align-items-center gap-2 mb-3" data-table-pager="#inventoryTable">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-page-prev>Prev 10</button>
        <label class="small text-muted mb-0" for="inventoryPageSize">Rows</label>
        <input id="inventoryPageSize"
               type="number"
               min="1"
               value="10"
               class="form-control form-control-sm"
               style="width: 90px;"
               data-page-size />
        <button type="button" class="btn btn-outline-secondary btn-sm" data-page-next>Next 10</button>
    </div>

    <table class="table table-hover align-middle" id="inventoryTable">
        <thead><tr><th>Book Name</th><th>Condition</th><th>Price</th><th>Purchased</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(string.IsNullOrWhiteSpace(item.BookTitle) ? item.Isbn : item.BookTitle)</td>
                <td>@(string.IsNullOrWhiteSpace(item.ConditionDescription) ? "N/A" : item.ConditionDescription)</td>
                <td>@(item.Price.HasValue ? item.Price.Value.ToString("C") : "N/A")</td>
                <td>@item.Purchased</td>
                <td class="text-end table-actions">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.InventoryId" asp-route-isbn="@item.Isbn" asp-route-ranks="@item.Ranks" asp-route-purchased="@item.Purchased">Edit</a>
                    <form class="d-inline" asp-action="Delete" asp-route-id="@item.InventoryId" method="post" data-confirm="Delete this inventory item?">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
