@model InventoryFormViewModel

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input asp-for="InventoryId" type="hidden" />
    <div class="mb-3">
        <label asp-for="Isbn" class="form-label"></label>
        <select asp-for="Isbn" asp-items="ViewBag.Books" class="form-select">
            <option value="">Choose book</option>
        </select>
        <span asp-validation-for="Isbn" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Ranks" class="form-label"></label>
        <select asp-for="Ranks" asp-items="ViewBag.Conditions" class="form-select">
            <option value="">Choose condition</option>
        </select>
        <span asp-validation-for="Ranks" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
