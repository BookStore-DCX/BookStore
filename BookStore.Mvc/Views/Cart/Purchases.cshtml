@model List<PurchaseLogViewModel>
@{
    ViewData["Title"] = "Purchases";
}

<div class="page-title">
    <h1 class="h3 mb-0">Purchase History</h1>
</div>

<div class="content-panel p-3">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No purchases yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Book Title</th>
                        <th>Author</th>
                        <th>Price</th>
                        <th>Condition</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.BookTitle ?? "Unknown book")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.AuthorName) ? "Unknown author" : item.AuthorName)</td>
                        <td>@(item.Price?.ToString("C") ?? "Not available")</td>
                        <td>@(item.Condition ?? "Unknown")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
