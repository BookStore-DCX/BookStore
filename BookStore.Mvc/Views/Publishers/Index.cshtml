@model List<PublisherViewModel>
@{
    ViewData["Title"] = "Publishers";
}

<div class="page-title">
    <h1 class="h3 mb-0">Publishers</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
    {
        <a class="btn btn-primary" asp-action="Create">Add Publisher</a>
    }
</div>

<div class="content-panel p-3">
    <input class="form-control mb-3" placeholder="Filter publishers" data-table-filter="#publishersTable" />
    <table class="table table-hover align-middle" id="publishersTable">
        <thead><tr><th>ID</th><th>Name</th><th>City</th><th>State</th><th></th></tr></thead>
        <tbody>
        @foreach (var publisher in Model)
        {
            <tr>
                <td>@publisher.PublisherId</td>
                <td>@publisher.Name</td>
                <td>@publisher.City</td>
                <td>@publisher.StateName (@publisher.StateCode)</td>
                <td class="text-end table-actions">
                    @if (User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@publisher.PublisherId">Edit</a>
                        <form class="d-inline" asp-action="Delete" asp-route-id="@publisher.PublisherId" method="post" data-confirm="Delete this publisher?">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
